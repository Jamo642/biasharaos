PORT=3000
APP_BASE_URL=http://localhost:3000
DEMO_MODE=false

# Google sign-in. OAuth "Web application" Client ID from
# https://console.cloud.google.com/apis/credentials (public, not a secret).
# Empty hides the Google button.
GOOGLE_CLIENT_ID=

# Emailed sign-in codes via Brevo's HTTPS API (https://app.brevo.com, SMTP & API keys).
# Sender must be a verified sender in Brevo. Empty key hides email-code sign-in.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Biashara OS

# Supabase Storage backup of the SQLite files (Render's free disk is wiped on
# restart). Service role key is a server secret. Use a separate bucket per env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=biashara-data

# Set to true behind Render/Cloudflare so limits use the visitor's real IP.
TRUST_PROXY=false
# New accounts allowed per IP per day.
SIGNUP_LIMIT_PER_IP=3

# Africa's Talking
AFRICASTALKING_ENV=sandbox
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SMS_SENDER_ID=
AFRICASTALKING_VOICE_NUMBER=
WEBHOOK_SHARED_SECRET=

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3000/api/webhooks/mpesa/callback

# OpenRouter AI. Empty key keeps the deterministic local parser enabled.
# Create a key at https://openrouter.ai/keys — never expose it to the browser.
OPENROUTER_API_KEY=
# Any model available in your OpenRouter account, e.g. openrouter/auto.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# NVIDIA NIM AI. If set, NVIDIA is used before OpenRouter.
AI_PROVIDER=
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
